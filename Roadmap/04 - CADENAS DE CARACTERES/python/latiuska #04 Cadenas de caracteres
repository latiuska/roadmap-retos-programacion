def isograma(string):
    #Creo un set para ver todas las letras existentes en la palabra
    letters = set()
    #Bucle para extraer cada letra de la palabra
    for letra in string:
        if letra.upper().lower() in letters and letra != "-" and letra != " ":
            return False
        #Añado las letras al set
        letters.add(letra.upper().lower())
    else:
        return True

string = "superfagiltco"
if isograma(string):
    print(f"La palabra \"{string}\" es un isograma")
else:
    print((f" La palabra \"{string}\" tiene letras repetidas"))

isograma("superfagiltco")
