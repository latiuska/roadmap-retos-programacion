def palindromos(palabra1,palabra2):

    if palabra1 == palabra2[::-1]:
        return f"La palabra {palabra1} es palíndrome"
    else:
        return "No es palíndrome"

resultado = palindromos('arroz', 'zorra')
print(resultado)

