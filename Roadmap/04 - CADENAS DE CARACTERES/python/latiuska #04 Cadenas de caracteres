    print(f"¿{word2} es un palíndromo?: {word2 == word2[::-1]}")

prueba = check('anilina', 'ala')
print(prueba)

def anagrama(palabra1, palabra2):
    lista1 = set()
    lista2 = set()
    #Recorro los items de la cadena 1 y los añado al set
    for letra in palabra1:
        if letra.upper().lower() in palabra1 and letra != "-" and letra != " ":
            lista1.add(letra.upper().lower())
    #Recorro los items de la cadena 2 y los añado al set
    for letra in palabra2:
        if letra.upper().lower() in palabra2 and letra != "-" and letra != "":
            lista2.add(letra.upper().lower())
    #Comparo ambos sets
    if lista1 == lista2:
        return "Es un anagrama"
    else:
        return "No es un anagrama"

    #Llamo a la función
prueba = anagrama('caso', 'saco')
print(prueba)

