#Funciones con datos por referencia

def mi_lista_func(mi_lista: list):
    mi_lista.append(50)
    print(mi_lista)

    mi_lista_3 = mi_lista
    mi_lista_3.append(90)

    print(f" Esta es mi lista: {mi_lista}")
    print(f" Esta es mi lista 3: {mi_lista_3}")

mi_lista_2 = [60, 70]
mi_lista_func(mi_lista_2)
print(mi_lista_2)

#EXTRA

#Si queremos mantener la referencia de datos antiguos, en vez de asignar una nueva variable mejor es copiarlo.

Por valor
def value(valor1:int, valor2: int) -> tuple:
    #ue(mi_variable1, mi_variable2)
    temp = valor1
    valor1 = valor2
    valor2 = temp
    return valor1, valor2

mi_variable1 = 10
mi_variable2 = 20
mi_variable3, mi_variable4 = value(mi_variable1, mi_variable2)

print(f"{mi_variable1}, {mi_variable2}")
print(f"{mi_variable3}, {mi_variable4}")

#Por referencia

def value(valor1:list, valor2: list) -> tuple:
    #ue(mi_variable1, mi_variable2)
    temp = valor1
    valor1 = valor2
    valor2 = temp
    return valor1, valor2

mi_lista_3 = [10,20]
mi_lista_4 = [30,40]
mi_lista_5, mi_lista_6 = value(mi_lista_3, mi_lista_4)

print(f"{mi_lista_3}, {mi_lista_4}")
print(f"{mi_lista_5}, {mi_lista_6}")
