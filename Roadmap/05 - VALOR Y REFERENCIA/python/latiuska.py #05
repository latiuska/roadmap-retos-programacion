#Tipos de datos pasados por referencia (todos los datos que no son primitivos: lista, tupla, set, diccionario)
#Los datos por referencia heredan los valores del dato original, ocupan el mismo espacio en memoria por eso se duplican los valores.
#Lo que tocamos por referencia modifica a todos los valores de la variable.

mi_lista = [10,20]
mi_lista_1 = [30,40]
mi_lista_1 = mi_lista
mi_lista_1.append(30)
print(mi_lista)
print(mi_lista_1)

